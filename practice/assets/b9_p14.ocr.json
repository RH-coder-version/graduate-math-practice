[[[[155.0, 40.0], [532.0, 41.0], [532.0, 58.0], [155.0, 57.0]], "1.用高斯消去法为什么要选主元？哪些方程组可以不选主元？", 0.9970959382397788], [[[155.0, 60.0], [686.0, 60.0], [686.0, 79.0], [155.0, 79.0]], "答因为高斯消去过程中需要用主元素a（k=1，2，，n-1）作除数，所以如果出现", 0.9619932694312854], [[[127.0, 80.0], [687.0, 80.0], [687.0, 99.0], [127.0, 99.0]], "a=0，那么消去过程将无法进行，而且即使主元素a≠0，但其值很小，那么如果用其值作", 0.9809018591555153], [[[129.0, 102.0], [686.0, 102.0], [686.0, 119.0], [129.0, 119.0]], "除数，也会导致其他元素数量级的严重增长和舍人误差的扩散，最后导致计算解不可靠，因此", 0.9971503964284572], [[[129.0, 123.0], [286.0, 123.0], [286.0, 140.0], [129.0, 140.0]], "用高斯消去法需要选主元.", 0.9943410456180573], [[[157.0, 142.0], [559.0, 143.0], [559.0, 160.0], [157.0, 159.0]], "当线性方程组的系数矩阵A正定对称时，高斯消去法不需要选主元.", 0.9838418106238047], [[[156.0, 164.0], [685.0, 164.0], [685.0, 180.0], [156.0, 180.0]], "2.高斯消去法与LU分解有什么关系？用它们解线性方程组Ax=b有何不同？A要满", 0.9940096415006198], [[[131.0, 185.0], [207.0, 185.0], [207.0, 200.0], [131.0, 200.0]], "足什么条件？", 0.983512411514918], [[[155.0, 204.0], [686.0, 204.0], [686.0, 223.0], [155.0, 223.0]], "答当不需要选主元时，高斯消去法实质上产生了一个将A分解为两个三角矩阵相乘的", 0.9971576655233229], [[[129.0, 226.0], [447.0, 226.0], [447.0, 242.0], [129.0, 242.0]], "因式分解，即LU分解，A=LU，且这种分解是唯一的.", 0.9746967645791861], [[[157.0, 246.0], [686.0, 246.0], [686.0, 262.0], [157.0, 262.0]], "当需要进行选主元（列主元）时，高斯消去法相当于先对A进行一系列行交换，然后再进", 0.9960224414483095], [[[128.0, 266.0], [437.0, 266.0], [437.0, 284.0], [128.0, 284.0]], "行一般的高斯消去法，即存在排列阵P，使PA=LU.", 0.987519645690918], [[[157.0, 288.0], [373.0, 288.0], [373.0, 304.0], [157.0, 304.0]], "能进行LU分解的条件是A非奇异.", 0.9734905920922756], [[[155.0, 308.0], [440.0, 308.0], [440.0, 324.0], [155.0, 324.0]], "3.楚列斯基分解与LU分解相比，有什么优点？", 0.9968036250634627], [[[154.0, 327.0], [685.0, 328.0], [685.0, 346.0], [154.0, 344.0]], "答当A为对称正定矩阵时，可以进行楚列斯基分解，与LU分解相比，楚列斯基分解具", 0.9966260414374503], [[[127.0, 348.0], [358.0, 349.0], [358.0, 366.0], [127.0, 365.0]], "有数值稳定，计算量、存储量小的优点.", 0.9729660749435425], [[[156.0, 370.0], [572.0, 370.0], [572.0, 386.0], [156.0, 386.0]], "4.哪种线性方程组可用平方根法求解？为什么说平方根法计算稳定？", 0.9978346267054158], [[[155.0, 389.0], [686.0, 389.0], [686.0, 408.0], [155.0, 408.0]], "答当线性方程组Ax=b的系数矩阵A为对称正定矩阵时，可以使用平方根法进行求", 0.9963326550818778], [[[129.0, 410.0], [402.0, 410.0], [402.0, 428.0], [129.0, 428.0]], "解，由于在A的楚列斯基分解A=LL中满足", 0.9978907942771912], [[[127.0, 467.0], [670.0, 467.0], [670.0, 483.0], [127.0, 483.0]], "即分解过程中元素的数量级不会增长且对角元素恒为正数，所以不选主元的平方根法是", 0.9989040195941925], [[[128.0, 487.0], [255.0, 487.0], [255.0, 504.0], [128.0, 504.0]], "一个数值稳定的方法.", 0.9504322409629822], [[[152.0, 508.0], [507.0, 508.0], [507.0, 524.0], [152.0, 524.0]], "5.什么样的线性方程组可用追赶法求解并能保证计算稳定？", 0.9975742388654638], [[[152.0, 528.0], [671.0, 528.0], [671.0, 544.0], [152.0, 544.0]], "答当系数矩阵为对角占优的三对角矩阵时，可以用追赶法求解，由追赶法的计算公式", 0.9776299378356418], [[[125.0, 546.0], [673.0, 547.0], [673.0, 564.0], [125.0, 563.0]], "可以看出计算过程不会出现中间结果数量级的巨大增长和舍人误差的严重积累，所以追赶法", 0.999330960214138], [[[127.0, 569.0], [213.0, 569.0], [213.0, 584.0], [127.0, 584.0]], "是数值稳定的.", 0.9565971153123038], [[[151.0, 588.0], [422.0, 588.0], [422.0, 605.0], [151.0, 605.0]], "6.何谓向量范数？给出三种常用的向量范数.", 0.9810516181446257], [[[150.0, 607.0], [591.0, 607.0], [591.0, 626.0], [150.0, 626.0]], "答如果向量x∈R\"（或x∈C）的某个实值函数N（x）=x，满足条件：", 0.9303078879328335], [[[152.0, 628.0], [359.0, 628.0], [359.0, 645.0], [152.0, 645.0]], "（1）|x≥0，且x=0=x=0；", 0.862734325668391], [[[151.0, 646.0], [422.0, 647.0], [422.0, 668.0], [151.0, 667.0]], "（2）1lax|=｜a·xl，Va∈R（或a∈C）；", 0.7191239354702142], [[[151.0, 667.0], [339.0, 668.0], [339.0, 688.0], [151.0, 687.0]], "（3）|x+y|≤x|+yll，", 0.6798792313784361], [[[125.0, 690.0], [415.0, 690.0], [415.0, 706.0], [125.0, 706.0]], "则称N（x）是R\"（或C）上的一个向量范数（或模）.", 0.926408588886261]]